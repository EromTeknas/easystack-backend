{
  "compilerOptions": {
    /* Runtime */
      "target": "ES2020",
      "module": "CommonJS",
      "moduleResolution": "Node",
      "allowImportingTsExtensions": true,
      "emitDeclarationOnly": true,
    /* Paths */
    "rootDir": "src",
    "outDir": "dist",

    /* Node */
    "types": ["node"],
    "lib": ["ES2022"],

    /* Output */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Compatibility */
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "ts-node": {
    "files": true
  },
  "include": ["src"]
}