generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

//////////////////////////////////////////////////////////////
// USERS
//////////////////////////////////////////////////////////////

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String @map("password_hash")

  firstName String? @map("first_name")
  lastName  String? @map("last_name")

  status UserStatus @default(PENDING_VERIFICATION)

  emailVerified       Boolean @default(false) @map("email_verified")
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")

  lastLoginAt DateTime? @map("last_login_at")

  deletedAt DateTime? @map("deleted_at")

  defaultWorkspaceId Int? @map("default_workspace_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  workspaceMemberships WorkspaceMember[]

  createdWorkspaces Workspace[] @relation("WorkspaceCreatedBy")
  createdProjects   Project[]   @relation("ProjectCreatedBy")

  roles                Role[]
  defaultWorkspace     Workspace?     @relation("UserDefaultWorkspace", fields: [defaultWorkspaceId], references: [id], map: "User_defaultWorkspace_fkey")
  billingSubscriptions Subscription[] @relation("SubscriptionBillingOwner")

  @@index([status])
}

//////////////////////////////////////////////////////////////
// REFRESH TOKENS
//////////////////////////////////////////////////////////////

model RefreshToken {
  id Int @id @default(autoincrement())

  userId Int @map("user_id")

  familyId String @map("family_id")

  tokenHash String @map("token_hash")

  expiresAt DateTime @map("expires_at")

  revokedAt DateTime? @map("revoked_at")

  ipAddress String? @map("ip_address")

  userAgent String? @map("user_agent")

  deviceName String? @map("device_name")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

//////////////////////////////////////////////////////////////
// WORKSPACES
//////////////////////////////////////////////////////////////

model Workspace {
  id Int @id @default(autoincrement())

  name String

  slug String @unique

  logoUrl String? @map("logo_url")

  createdById Int @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  createdBy User @relation("WorkspaceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  members WorkspaceMember[]

  projects              Project[]
  roles                 Role[]
  defaultForUsers       User[]                @relation("UserDefaultWorkspace")
  discountUsages        DiscountUsage[]
  subscription          Subscription?
  usages                Usage[]
  payments              Payment[]
  invoices              Invoice[]
  subscriptionHistories SubscriptionHistory[]

  @@index([createdById])
}

//////////////////////////////////////////////////////////////
// PROJECTS
//////////////////////////////////////////////////////////////

model Project {
  id Int @id @default(autoincrement())

  workspaceId Int @map("workspace_id")

  name String

  slug String @unique

  description String?

  createdById Int @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdBy User @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  members ProjectMember[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([createdById])
  @@index([slug])
}

//////////////////////////////////////////////////////////////
// WORKSPACE MEMBERS
//////////////////////////////////////////////////////////////

model WorkspaceMember {
  id Int @id @default(autoincrement())

  workspaceId Int

  userId Int

  roleId Int

  joinedAt DateTime @default(now()) @map("joined_at")

  removedAt DateTime? @map("removed_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  projectMemberships ProjectMember[]

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([roleId])
}

//////////////////////////////////////////////////////////////
// PROJECT MEMBERS
//////////////////////////////////////////////////////////////

model ProjectMember {
  id Int @id @default(autoincrement())

  projectId Int

  workspaceMemberId Int

  roleId Int

  joinedAt DateTime @default(now()) @map("joined_at")

  removedAt DateTime? @map("removed_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([projectId, workspaceMemberId])
  @@index([projectId])
  @@index([workspaceMemberId])
  @@index([roleId])
}

//////////////////////////////////////////////////////////////
// ROLES
//////////////////////////////////////////////////////////////

model Role {
  id Int @id @default(autoincrement())

  key String @unique

  name String

  description String?

  scope RoleScope

  isSystem Boolean @default(true) @map("is_system")

  workspaceId Int? @map("workspace_id")

  createdById Int? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  workspaceMembers WorkspaceMember[]

  projectMembers ProjectMember[]

  permissions RolePermission[]

  @@index([scope])
  @@index([workspaceId])
  @@index([createdById])
}

//////////////////////////////////////////////////////////////
// PERMISSIONS
//////////////////////////////////////////////////////////////

model Permission {
  id Int @id @default(autoincrement())

  key String @unique

  resource String

  action String

  description String?

  createdAt DateTime @default(now()) @map("created_at")

  roleMappings RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@index([action])
}

//////////////////////////////////////////////////////////////
// ROLE -> PERMISSION
//////////////////////////////////////////////////////////////

model RolePermission {
  roleId Int

  permissionId Int

  createdAt DateTime @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

//////////////////////////////////////////////////////////////
// PLANS
//////////////////////////////////////////////////////////////
model Plan {
  id Int @id @default(autoincrement())

  key String @unique

  displayName String

  description String?

  isPublic Boolean @default(true)

  isEnterprise Boolean @default(false)

  isActive Boolean @default(true)

  displayOrder Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  versions PlanVersion[]

  @@index([isActive])
}

//////////////////////////////////////////////////////////////
// PLAN VERSIONS
//////////////////////////////////////////////////////////////

model PlanVersion {
  id Int @id @default(autoincrement())

  planId Int

  version Int

  isLatest Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  trial TrialConfiguration?

  pricing PlanPricing[]

  features PlanFeature[]

  quotas PlanQuota[]

  subscriptions         Subscription[]
  subscriptionHistories SubscriptionHistory[]

  @@unique([planId, version])
  @@index([planId])
  @@index([isLatest])
}

//////////////////////////////////////////////////////////////
// TRIAL CONFIGURATION
//////////////////////////////////////////////////////////////
model TrialConfiguration {
  id Int @id @default(autoincrement())

  planVersionId Int @unique

  durationDays Int

  enabled Boolean @default(true)

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////////////
// PLAN PRICING
//////////////////////////////////////////////////////////////
model PlanPricing {
  id Int @id @default(autoincrement())

  planVersionId Int

  displayName String?

  currency String

  billingCycle BillingCycle

  amount Decimal @db.Decimal(12, 2)

  compareAtAmount Decimal? @db.Decimal(12, 2)

  isDefault Boolean @default(false)

  activeFrom DateTime?

  activeUntil DateTime?

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  discounts PricingDiscount[]

  @@index([planVersionId])
}

////////////////////////////////////////////////////////////////
// DISCOUNTS
////////////////////////////////////////////////////////////

model Discount {
  id Int @id @default(autoincrement())

  code String @unique

  displayName String

  description String?

  type DiscountType

  priority Int @default(0)

  percentage Decimal? @db.Decimal(5, 2)

  fixedAmount Decimal? @db.Decimal(12, 2)

  maxUses Int?

  usedCount Int @default(0)

  startsAt DateTime?

  expiresAt DateTime?

  isActive Boolean @default(true)

  pricing PricingDiscount[]

  createdAt DateTime @default(now())

  updatedAt      DateTime        @updatedAt
  discountUsages DiscountUsage[]
}

//////////////////////////////////////////////////////////////
// DISCOUNT USAGE
//////////////////////////////////////////////////////////////

model DiscountUsage {
  id Int @id @default(autoincrement())

  discountId Int

  workspaceId Int

  subscriptionId Int

  paymentId Int?

  redeemedAt DateTime @default(now())

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@unique([discountId, workspaceId, subscriptionId])
  @@index([discountId])
  @@index([workspaceId])
}

////////////////////////////////////////////////////////////////
// PRICING DISCOUNT
////////////////////////////////////////////////////////////
model PricingDiscount {
  pricingId Int

  discountId Int

  pricing PlanPricing @relation(fields: [pricingId], references: [id], onDelete: Cascade)

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@id([pricingId, discountId])
}

///////////////////////////////////////////////////////////////
// FEATURES
///////////////////////////////////////////////////////////////
model Feature {
  id Int @id @default(autoincrement())

  key String @unique

  displayName String

  description String?

  category String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  plans PlanFeature[]

  sortOrder Int @default(0)
}

///////////////////////////////////////////////////////////////
// PLAN FEATURES
///////////////////////////////////////////////////////////////
model PlanFeature {
  planVersionId Int

  featureId Int

  enabled Boolean @default(true)

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planVersionId, featureId])
}

////////////////////////////////////////////////////////////////
// QUOTAS
////////////////////////////////////////////////////////////
model Quota {
  id Int @id @default(autoincrement())

  key String @unique

  displayName String

  description String?

  unit String

  resetPolicy QuotaResetPolicy

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  plans PlanQuota[]

  usage Usage[]

  sortOrder Int @default(0)
}

////////////////////////////////////////////////////////////////
// PLAN QUOTAS
////////////////////////////////////////////////////////////
model PlanQuota {
  planVersionId Int

  quotaId Int

  value Int?

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  quota Quota @relation(fields: [quotaId], references: [id], onDelete: Cascade)

  @@id([planVersionId, quotaId])
}

//////////////////////////////////////////////////////////////
// SUBSCRIPTIONS
//////////////////////////////////////////////////////////////

model Subscription {
  id Int @id @default(autoincrement())

  workspaceId Int @unique

  planVersionId Int

  status SubscriptionStatus

  gateway PaymentGateway?

  trialEndsAt DateTime?

  startsAt DateTime

  expiresAt DateTime?

  cancelledAt DateTime?

  customOverride Json?

  gatewayCustomerId     String?
  gatewaySubscriptionId String?

  billingOwnerId Int?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  billingOwner User? @relation("SubscriptionBillingOwner", fields: [billingOwnerId], references: [id])

  planVersion           PlanVersion           @relation(fields: [planVersionId], references: [id])
  discountUsages        DiscountUsage[]
  subscriptionHistories SubscriptionHistory[]
  payments              Payment[]
  invoices              Invoice[]

  @@index([status])
  @@index([planVersionId])
}

//////////////////////////////////////////////////////////////
// SUBSCRIPTION HISTORY
//////////////////////////////////////////////////////////////

model SubscriptionHistory {
  id Int @id @default(autoincrement())

  workspaceId Int

  subscriptionId Int

  planVersionId Int

  status SubscriptionStatus

  startsAt DateTime

  endsAt DateTime?

  reason String?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id])

  @@index([workspaceId])
  @@index([subscriptionId])
  @@index([planVersionId])
}

//////////////////////////////////////////////////////////////
// USAGE
//////////////////////////////////////////////////////////////
model Usage {
  id Int @id @default(autoincrement())

  workspaceId Int
  quotaId     Int

  value Int @default(0)

  resetAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  quota     Quota     @relation(fields: [quotaId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, quotaId])
  @@index([workspaceId])
}

//////////////////////////////////////////////////////////////
// PAYMENTS
//////////////////////////////////////////////////////////////

model Payment {
  id Int @id @default(autoincrement())

  workspaceId Int

  subscriptionId Int?

  gateway PaymentGateway

  gatewayPaymentId String

  gatewayInvoiceId String?

  gatewayCustomerId String?

  gatewayPriceId String?

  amount Decimal @db.Decimal(12, 2)

  currency String

  status PaymentStatus

  billingCycle BillingCycle?

  paidAt DateTime?

  refundedAt DateTime?

  metadata Json?

  // Optional idempotency key to dedupe duplicate purchase requests
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  discountUsages DiscountUsage[]
  invoices       Invoice[]

  @@index([workspaceId])
  @@index([subscriptionId])
  @@index([gatewayPaymentId])
  @@index([status])
}

//////////////////////////////////////////////////////////////
// INVOICES
//////////////////////////////////////////////////////////////

model Invoice {
  id Int @id @default(autoincrement())

  workspaceId Int?

  subscriptionId Int

  paymentId Int?

  invoiceNumber String @unique

  amount Decimal @db.Decimal(12, 2)

  taxAmount Decimal @db.Decimal(12, 2)

  total Decimal @db.Decimal(12, 2)

  currency String

  issuedAt DateTime

  dueAt DateTime?

  paidAt DateTime?

  pdfUrl String?

  metadata Json?

  createdAt DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([workspaceId])
  @@index([subscriptionId])
}

//////////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////////

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  EXPIRED
}

enum RoleScope {
  WORKSPACE
  PROJECT
}

enum BillingCycle {
  MONTHLY
  YEARLY
  LIFETIME
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum QuotaResetPolicy {
  NEVER
  MINUTELY
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  BILLING_CYCLE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

enum PaymentGateway {
  STRIPE
  RAZORPAY
  PADDLE
  LEMON_SQUEEZY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

