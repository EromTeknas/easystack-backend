    {
      "name": "Error Examples",
      "description": "Examples of different error responses",
      "item": [
        {
          "name": "404 - Not Found (Example)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Response status is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"Error structure is correct\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.equal(false);",
                  "    pm.expect(jsonData.error.code).to.equal('NOT_FOUND');",
                  "    pm.expect(jsonData.error).to.have.property('requestId');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/invalid-endpoint",
              "host": ["{{base_url}}"],
              "path": ["api", "invalid-endpoint"]
            },
            "description": "This endpoint doesn't exist - demonstrates 404 error handling"
          },
          "response": [
            {
              "name": "404 - Not Found",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "http://localhost:3000/api/invalid-endpoint",
                  "protocol": "http",
                  "host": ["localhost"],
                  "port": "3000",
                  "path": ["api", "invalid-endpoint"]
                }
              },
              "status": "Not Found",
              "code": 404,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n    \"success\": false,\n    \"error\": {\n        \"message\": \"Cannot GET /api/invalid-endpoint\",\n        \"code\": \"NOT_FOUND\",\n        \"statusCode\": 404,\n        \"requestId\": \"abc123def456\"\n    }\n}"
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
