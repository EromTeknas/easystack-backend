# Environment variables for EasyStack Backend
# Copy this file to .env and update the values as needed.

# App
APP_NAME=easystack-backend
ENVIRONMENT=local
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_DIR=storage/logs
LOG_IDENTIFIER=easystack
BASE_URL=http://localhost:3000
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=easystack
MYSQL_DATABASE_SHADOW=easystack_shadow

# Migration user (schema changes, Prisma migrations)
MYSQL_MIGRATION_USER=easystack_migrate
MYSQL_MIGRATION_PASSWORD=strong-migration-password

# Application user (runtime API access only)
MYSQL_APP_USER=easystack_app
MYSQL_APP_PASSWORD=strong-app-password

# Prisma URLs (CLI)
# DATABASE_URL and SHADOW_DATABASE_URL are used by Prisma CLI.
# Runtime API uses MYSQL_APP_USER / MYSQL_APP_PASSWORD and does NOT
# depend on these credentials.
DATABASE_URL="mysql://${MYSQL_MIGRATION_USER}:${MYSQL_MIGRATION_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}"
SHADOW_DATABASE_URL="mysql://${MYSQL_MIGRATION_USER}:${MYSQL_MIGRATION_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE_SHADOW}"

# MongoDB
MONGO_URI=mongodb://easystack:strong-password@localhost:27017/easystack

# JWT Authentication
JWT_SECRET=your-super-secret-key-min-32-characters-long-must-be-changed!!!
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-characters-long-must-be-changed!!!
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_MINUTES=43200

# Auth Cookie Settings (access + refresh)
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAMESITE=strict
AUTH_COOKIE_SECURE=false

# Password Hashing
BCRYPT_ROUNDS=12

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Password Reset
PASSWORD_RESET_EXPIRY_MINUTES=30

# Pending User Cleanup
PENDING_USER_EXPIRY_HOURS=48

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=10

# Email Service (Brevo)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@easystack.io
BREVO_SENDER_NAME=EasyStack

# Token Rotation (optional)
ENABLE_REFRESH_TOKEN_ROTATION=false

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,x-request-id
CORS_EXPOSED_HEADERS=x-request-id
CORS_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=86400
FRONTEND_URL=http://localhost:3000
APP_FRONTEND_URL=http://localhost:3000

# S3-compatible storage service (AWS S3, Cloudflare R2, MinIO, etc.)
STORAGE_CDN_BASE_URL=http://localhost:8081
STORAGE_PRIVATE_URL_EXPIRY_SECONDS=300
STORAGE_CLEANED_INTENT_RETENTION_DAYS=30
STORAGE_S3_BUCKET=easystack
STORAGE_S3_REGION=us-east-1
STORAGE_S3_INTERNAL_ENDPOINT=http://localhost:9000
STORAGE_S3_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_ACCESS_KEY_ID=easystack
STORAGE_S3_SECRET_ACCESS_KEY=easystack-secret
STORAGE_S3_SESSION_TOKEN=

# Google OAuth
GOOGLE_AUTH_CLIENT_ID=

# Billing jobs
BILLING_RESET_TEST_MODE=false

# Worker process group: email, storage, or all.
# CLI arguments used by worker scripts take precedence.
WORKER_GROUP=all
