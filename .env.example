# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=easystack
MYSQL_DATABASE_SHADOW=easystack_shadow

# Migration user (schema changes, Prisma migrations)
MYSQL_MIGRATION_USER=easystack_migrate
MYSQL_MIGRATION_PASSWORD=strong-migration-password

# Application user (runtime API access only)
MYSQL_APP_USER=easystack_app
MYSQL_APP_PASSWORD=strong-app-password

# Prisma URLs (CLI)
# DATABASE_URL and SHADOW_DATABASE_URL are used by Prisma CLI.
# Runtime API uses MYSQL_APP_USER / MYSQL_APP_PASSWORD and does NOT
# depend on these credentials.
DATABASE_URL="mysql://${MYSQL_MIGRATION_USER}:${MYSQL_MIGRATION_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}"
SHADOW_DATABASE_URL="mysql://${MYSQL_MIGRATION_USER}:${MYSQL_MIGRATION_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE_SHADOW}"

# App
ENVIRONMENT=local
NODE_ENV=development
PORT=3000
APP_PORT=3000
LOG_LEVEL=info
LOG_DIR=storage/logs
LOG_IDENTIFIER=easystack
BASE_URL=http://localhost:3000

# JWT Authentication
JWT_SECRET=your-super-secret-key-min-32-characters-long-must-be-changed!!!
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-characters-long-must-be-changed!!!
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# Auth Cookie Settings (access + refresh)
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAMESITE=strict
AUTH_COOKIE_SECURE=false

# Password Hashing
BCRYPT_ROUNDS=12

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Password Reset
PASSWORD_RESET_EXPIRY_MINUTES=30
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Pending User Cleanup
PENDING_USER_EXPIRY_HOURS=48

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=10

# Email Service (Brevo)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@easystack.io
BREVO_SENDER_NAME=EasyStack

# Token Rotation (optional)
ENABLE_REFRESH_TOKEN_ROTATION=false

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# S3-Compatible Storage Configuration (AWS S3, Cloudflare R2, MinIO, etc.)
# You can use either S3_* or AWS_S3_* variable names.
# For non-AWS providers, set S3_ENDPOINT and (for MinIO) S3_FORCE_PATH_STYLE=true.
S3_REGION=us-east-1
S3_BUCKET=easystack
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Worker Configuration (BullMQ)
# Comma-separated list of queue ids for this worker process.
# Supported values: email-otp, password-reset, welcome-email
# WORKER_QUEUES=email-otp,password-reset,welcome-email
