{
  "name": "easystack-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "migrate:up": "ts-node src/cli/migrate.ts up",
    "migrate:down": "ts-node src/cli/migrate.ts down",
    "migrate:status": "ts-node src/cli/migrate.ts status",
    "migrate:fresh": "ts-node src/cli/migrate.ts down:all && ts-node src/cli/migrate.ts up",
    "migrate:fresh:preserve": "ts-node src/cli/migrate.ts down:all -- --preserve-data && ts-node src/cli/migrate.ts up",
    "worker": "ts-node src/workers/index.worker.ts",
    "cleanup:pending-users": "ts-node src/cli/cleanup-pending-users.ts"
  },
  "keywords": [],
  "author": "Sanket More",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.67.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.5",
    "mysql2": "^3.16.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^4.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.10",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "prisma": "^6.2.1"
  }
}
