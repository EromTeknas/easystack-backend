# EasyStack Generic Environment Configuration Template (.env.example)
# Use this template to create .env.<env_name> (e.g. .env.staging, .env.qa)
COMPOSE_PROJECT_NAME=easystack-${ENV_NAME}
ENVIRONMENT=${ENV_NAME}

# Ports on Host
API_PORT=3002
DELIVERY_PORT=3005
FRONTEND_PORT=3000

# Base URLs
BASE_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000
FRONTEND_PUBLIC_API_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:3000

# Databases
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=easystack_${ENV_NAME}
MYSQL_MIGRATION_USER=easystack_migrate
MYSQL_MIGRATION_PASSWORD=strong-migration-password
MYSQL_APP_USER=easystack_app
MYSQL_APP_PASSWORD=strong-app-password

MONGO_URI=mongodb://easystack:strong-password@mongodb:27017/easystack_${ENV_NAME}?authSource=admin

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=10

# S3 & CDN Storage
STORAGE_CDN_BASE_URL=http://localhost:8081/${ENV_NAME}
STORAGE_S3_BUCKET=easystack-${ENV_NAME}
STORAGE_S3_REGION=us-east-1
STORAGE_S3_INTERNAL_ENDPOINT=http://seaweedfs:8333
STORAGE_S3_PUBLIC_ENDPOINT=http://localhost:8333
STORAGE_S3_ACCESS_KEY_ID=admin
STORAGE_S3_SECRET_ACCESS_KEY=admin12345

# Authentication Secrets
JWT_SECRET=generic-super-secret-key-min-32-characters-long!
JWT_REFRESH_SECRET=generic-super-refresh-key-min-32-characters-long!

# Google OAuth Configuration
GOOGLE_AUTH_CLIENT_ID=your_google_oauth_client_id_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Brevo Email Service
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@easystack.io
BREVO_SENDER_NAME=EasyStack

BACKEND_IMAGE=easystack-backend:${ENV_NAME}-latest
FRONTEND_IMAGE=easystack-frontend:${ENV_NAME}-latest
