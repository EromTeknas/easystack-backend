# ==============================================================================
# EasyStack Infrastructure Environment Template (.env.example)
# Copy this file to infra/.env for local Docker Compose execution.
# ==============================================================================

# Shared Infrastructure (compose.shared.yaml)
ENVIRONMENTS=dev,prod
STORAGE_S3_BUCKET_PREFIX=easystack

# MySQL Root Admin (Infrastructure only)
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password
MYSQL_HOST_PORT=3306

# MongoDB Root Admin (Infrastructure only)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=replace_with_mongo_root_password
MONGO_HOST_PORT=27017

# Redis
REDIS_HOST_PORT=6379

# MinIO Object Storage & CDN
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_minio_root_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
CDN_HOST_PORT=8081

# Jenkins
JENKINS_HOST_PORT=8080
JENKINS_AGENT_PORT=50000

# Observability Infrastructure (compose.observability.yaml)
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
LOKI_HOST_PORT=3100
CADVISOR_HOST_PORT=8082

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace_with_grafana_admin_password
GF_USERS_ALLOW_SIGN_UP=false
